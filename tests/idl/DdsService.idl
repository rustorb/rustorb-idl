#include <dds_rpc.idl>

// DDS services (DDS-RPC 1.0): an interface and one derived from it.
module Calc {
    exception TooBig {
        long limit;
    };

    @DDSService
    interface Adder {
        long add(in long a, in long b) raises (TooBig);
    };

    @DDSService
    interface Calculator : Adder {
        double divide(in double a, in double b, out double remainder);
        void clear(inout string log);
        oneway void note(in string text);
        attribute string name;
        readonly attribute unsigned long calls;
    };
};

// A service defined by a pair of types in the Basic Service Mapping
// (DDS-RPC 1.0, 7.3.1.4).
module Pair {
    @final @RPCRequestType struct Sum_Request {
        dds::rpc::RequestHeader header;
        long a;
        long b;
    };

    @final @RPCReplyType struct Sum_Reply {
        dds::rpc::ReplyHeader header;
        long sum;
    };
};
