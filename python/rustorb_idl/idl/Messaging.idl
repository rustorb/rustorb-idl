// The part of the Messaging module of CORBA 3.x (Messaging chapter) that
// callback AMI uses, written out from the specification text: the base of
// the AMI_<I>Handler interfaces that rustorb-idl -Wbami adds, and the
// ExceptionHolder they receive. rustorb-idl reads it by itself for -Wbami;
// the rustorb runtimes provide the code for it.
//
// ExceptionHolder's operations (raise_exception, raise_exception_with_list)
// are left out: the runtimes write them by hand, as their raises clause
// (UserExceptionBase) has no IDL form.

#ifndef _MESSAGING_IDL_
#define _MESSAGING_IDL_

#pragma prefix "omg.org"

module Messaging {
  interface ReplyHandler {};

  valuetype ExceptionHolder {
    private boolean is_system_exception;
    private boolean byte_order;
    private sequence<octet> marshaled_exception;
  };
};

#endif
